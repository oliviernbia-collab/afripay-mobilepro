{
  "expo": {
    "name": "AfriPay Pro",
    "slug": "afripay-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "scheme": "afripaypro",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.afripay.mobilepro",
      "infoPlist": {
        "NSCameraUsageDescription": "AfriPay Pro utilise la caméra pour scanner le QR code de paiement présenté par le client.",
        "NSPhotoLibraryUsageDescription": "AfriPay Pro a besoin d'accéder à vos photos pour envoyer vos documents KYB."
      }
    },
    "android": {
      "package": "com.afripay.mobilepro",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AfriPay Pro utilise la caméra pour scanner le QR code de paiement présenté par le client."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AfriPay Pro a besoin d'accéder à vos photos pour envoyer vos documents KYB."
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "b1ef5d37-cc40-40e5-8e14-f0d4e806b956"
      }
    },
    "owner": "kamenan"
  }
}
